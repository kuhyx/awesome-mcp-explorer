{
  "name": "awesome-mcp-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Power-user filter/sort explorer for punkpeye/awesome-mcp-servers, enriched with Glama grades and GitHub metadata.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check && eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build:data": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} node --experimental-strip-types scripts/build-dataset.ts"
  },
  "dependencies": {
    "@kuhyx/web-ui": "github:kuhyx/utils#web_ui-v0.5.0&path:/web_ui",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}

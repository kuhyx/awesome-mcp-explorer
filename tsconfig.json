{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "target": "ES2023",
    // ESNext lib (not target) so Iterator Helpers — `.values().toArray()` — are
    // declared. They ship in Node 22+ and every 2024+ browser engine, which is
    // this project's floor; the emit target stays at ES2023.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],

    /* Strictness on top of astro/strictest. */
    "strict": true,
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true,
    "allowJs": false
  },
  "include": [".astro/types.d.ts", "src", "scripts", "*.ts", "*.config.ts"],
  "exclude": ["dist", "node_modules"]
}

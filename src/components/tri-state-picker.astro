---
/**
 * A tri-state facet picker: each option cycles off -> include -> exclude.
 * Showing every option at once, with "not X" folded into the same control,
 * removes the need for a separate negation toggle. The state shown here is the
 * neutral one; `<server-explorer>` patches buttons, counts and summary in place.
 *
 * The heading is the facet's icon; an option shows its proper-noun name
 * (Rust, macOS) or, for generated values, the facet icon plus a glyph, drawn
 * dashed when the value is inferred rather than published.
 */
import type { FacetOption } from "../lib/facet-defs.ts";
import type { IconName } from "../lib/icons.ts";

import { GLYPHS } from "../lib/tri-state.ts";
import Icon from "./icon.astro";

interface Props {
  counts: ReadonlyMap<string, number>;
  facet: string;
  icon: IconName;
  inferred?: boolean;
  label: string;
  options: readonly FacetOption[];
}

const { counts, facet, icon, inferred = false, label, options } = Astro.props;
---

<fieldset aria-label={label} class="facet" data-facet={facet}>
  <legend>
    <Icon name={icon} />
    <span aria-label="Any" class="facet-summary" role="img">·</span>
  </legend>
  <div class="facet-options">
    {
      options.map((option) => {
        const count = counts.get(option.value) ?? 0;
        return (
          <button
            aria-label={`${option.name}: off`}
            aria-pressed="false"
            class="tri tri-off"
            data-key={facet}
            data-name={option.name}
            data-option={option.value}
            disabled={count === 0}
            type="button"
          >
            <span aria-hidden="true" class="tri-glyph">{GLYPHS.off}</span>
            {option.mark === undefined ? (
              <span class="tri-name">{option.name}</span>
            ) : (
              <span class:list={["tri-mark", { "tri-inferred": inferred }]}>
                <Icon name={icon} />
                {option.mark}
              </span>
            )}
            <span class="tri-count">{count}</span>
          </button>
        );
      })
    }
  </div>
</fieldset>

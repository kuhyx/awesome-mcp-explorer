---
/**
 * One server in the list.
 *
 * Cost and rate-limiting are *inferred* from the README's scope markers and
 * description text, so those chips render dashed; a value from
 * `data/overrides.json` is a checked fact and renders solid. An inferred value
 * must never be mistaken for a fact.
 *
 * Only content is printed as text (name, description, languages, scope,
 * categories, stars, date, SPDX id); everything else is an icon or glyph with
 * a spoken name and no tooltip.
 *
 * The age is printed as an absolute date: the browser swaps it for a relative
 * one on load, because a build-time "3d" would be wrong by the time it is read.
 */
import type { Server } from "../lib/server.ts";

import { COST_LABELS, COST_MARKS, formatDate, formatStars, RATE_LABELS, RATE_MARKS } from "../lib/format.ts";
import { GRADE_AXES } from "../lib/grade.ts";
import { AXIS_ICONS } from "../lib/icons.ts";
import Icon from "./icon.astro";

interface Props {
  server: Server;
}

const { server } = Astro.props;
const { gh, glama } = server;
const isArchived = gh?.archived === true;
const spdx = gh?.spdx ?? null;
const facts = [
  { fact: server.cost, icon: "coin", label: COST_LABELS[server.cost.value], mark: COST_MARKS[server.cost.value] },
  {
    fact: server.rateLimited,
    icon: "gauge",
    label: RATE_LABELS[server.rateLimited.value],
    mark: RATE_MARKS[server.rateLimited.value],
  },
] as const;
---

<article class:list={["row", { "row-archived": isArchived }]} data-id={server.id}>
  <div class="row-main">
    <div class="row-head">
      <a class="row-name" href={server.url} rel="noreferrer" target="_blank">{server.id}</a>
      {server.official && <span aria-label="Official implementation" class="chip chip-official" role="img">🎖️</span>}
      {isArchived && <span aria-label="Archived on GitHub" class="chip chip-dead" role="img"><Icon name="archive" /></span>}
    </div>
    <p class="row-desc">{server.description}</p>
    <div class="row-chips">
      {server.languages.map((language) => <span class="chip chip-lang">{language}</span>)}
      {server.scope.map((scope) => <span class="chip chip-scope">{scope}</span>)}
      {
        facts.map(({ fact, icon, label, mark }) => {
          return (
          <span
            aria-label={fact.source === "inferred" ? `${label}, inferred` : label}
            class:list={["chip", fact.source === "inferred" ? "chip-inferred" : "chip-fact"]}
            role="img"
          >
            <Icon name={icon} />
            {mark}
          </span>
          );
        })
      }
      {server.categories.map((category) => <span class="chip chip-cat">{category}</span>)}
    </div>
  </div>

  <div class="row-meta">
    <div class="grades">
      {
        glama === null ? (
          <span aria-label="not on Glama" class="grade grade-none" role="img">∅</span>
        ) : (
          GRADE_AXES.map((axis) => {
            return (
            <span
              aria-label={`${axis}: ${glama[axis] ?? "not graded"}`}
              class={`grade grade-${glama[axis] ?? "ungraded"}`}
              role="img"
            >
              <Icon name={AXIS_ICONS[axis]} />
              {glama[axis]}
            </span>
            );
          })
        )
      }
    </div>
    <div class="row-stats">
      <span aria-label="GitHub stars" role="img">★ {gh === null ? "?" : formatStars(gh.stars)}</span>
      {
        gh === null ? (
          <span aria-label="repository gone" class="foss-no" role="img"><Icon name="link-off" /></span>
        ) : (
          <span class="row-pushed"><Icon name="clock" /> <time class="row-age" datetime={gh.pushedAt}>{formatDate(gh.pushedAt)}</time></span>
        )
      }
      {
        spdx === null ? (
          <span aria-label="No licence file: all rights reserved" class="foss-no" role="img">©</span>
        ) : (
          <span class:list={["row-spdx", gh?.isFoss === "yes" ? "foss-yes" : "foss-no"]}>{spdx}</span>
        )
      }
    </div>
  </div>
</article>

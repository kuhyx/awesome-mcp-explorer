---
/**
 * Every icon on the page, hand-drawn on a 24-unit grid and emitted once.
 * Stroke and colour come from the `.icon` rule (currentColor), so an icon
 * takes the tone of the control it sits in. Names: `lib/icons.ts`.
 */
---

<svg aria-hidden="true" class="sprite" xmlns="http://www.w3.org/2000/svg">
  <symbol id="i-logo" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="3"></circle>
    <circle cx="4" cy="5" r="2"></circle>
    <circle cx="20" cy="5" r="2"></circle>
    <circle cx="12" cy="21" r="2"></circle>
    <path d="M5.6 6.2 9.6 10M18.4 6.2 14.4 10M12 15v4"></path>
  </symbol>
  <symbol id="i-search" viewBox="0 0 24 24">
    <circle cx="10.5" cy="10.5" r="6.5"></circle>
    <path d="m15.5 15.5 5 5"></path>
  </symbol>
  <symbol id="i-code" viewBox="0 0 24 24"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"></path></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24">
    <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path>
    <circle cx="12" cy="9.5" r="2.5"></circle>
  </symbol>
  <symbol id="i-monitor" viewBox="0 0 24 24">
    <rect height="12" rx="1.5" width="18" x="3" y="4"></rect>
    <path d="M9 20h6M12 16v4"></path>
  </symbol>
  <symbol id="i-scale" viewBox="0 0 24 24">
    <path d="M12 4v16M7 20h10M5 7h14M5 7l-3 7h6zM19 7l-3 7h6z"></path>
  </symbol>
  <symbol id="i-coin" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8.5"></circle>
    <circle cx="12" cy="12" r="5"></circle>
  </symbol>
  <symbol id="i-gauge" viewBox="0 0 24 24">
    <path d="M3.5 17a9 9 0 1 1 17 0M12 14l4.5-5"></path>
    <circle cx="12" cy="14.5" fill="currentColor" r="1.3"></circle>
  </symbol>
  <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6.5V18a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1h-8l-2-2.5H4a1 1 0 0 0-1 1z"></path></symbol>
  <symbol id="i-star" viewBox="0 0 24 24"><path d="m12 3 2.8 5.8 6.2.9-4.5 4.4 1 6.2L12 17.4l-5.5 2.9 1-6.2L3 9.7l6.2-.9z"></path></symbol>
  <symbol id="i-wrench" viewBox="0 0 24 24"><path d="M14.5 4a5 5 0 0 0 5.6 6.6l-9 9a2.1 2.1 0 0 1-3-3l9-9A5 5 0 0 1 14.5 4z"></path></symbol>
  <symbol id="i-clock" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8.5"></circle>
    <path d="M12 7v5l3.5 2"></path>
  </symbol>
  <symbol id="i-calendar" viewBox="0 0 24 24">
    <rect height="15" rx="1.5" width="17" x="3.5" y="5.5"></rect>
    <path d="M3.5 10h17M8 3.5v4M16 3.5v4"></path>
  </symbol>
  <symbol id="i-grade" viewBox="0 0 24 24">
    <circle cx="12" cy="9" r="5.5"></circle>
    <path d="m8.5 13.5-2 7 5.5-2.5 5.5 2.5-2-7"></path>
  </symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8 7.5 9.5 4.3-1.5 7.5-4.9 7.5-9.5V6z"></path></symbol>
  <symbol id="i-sort" viewBox="0 0 24 24"><path d="M7 4v16M3.5 16.5 7 20l3.5-3.5M17 20V4M13.5 7.5 17 4l3.5 3.5"></path></symbol>
  <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 4v11M7 10.5l5 5 5-5M4.5 20h15"></path></symbol>
  <symbol id="i-link" viewBox="0 0 24 24">
    <path d="M10 14a4 4 0 0 0 5.7 0l3.6-3.6a4 4 0 0 0-5.7-5.7L12 6.3"></path>
    <path d="M14 10a4 4 0 0 0-5.7 0l-3.6 3.6a4 4 0 0 0 5.7 5.7l1.6-1.6"></path>
  </symbol>
  <symbol id="i-link-off" viewBox="0 0 24 24">
    <path d="M15.7 14 19.3 10.4a4 4 0 0 0-5.7-5.7L12 6.3M8.3 10l-3.6 3.6a4 4 0 0 0 5.7 5.7l1.6-1.6M3 3l18 18"></path>
  </symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="m4.5 12.5 5 5 10-11"></path></symbol>
  <symbol id="i-reset" viewBox="0 0 24 24"><path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3M4.5 4v4.5H9"></path></symbol>
  <symbol id="i-save" viewBox="0 0 24 24"><path d="M6 3.5h12v17l-6-4.5-6 4.5zM12 7.5v5M9.5 10h5"></path></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></symbol>
  <symbol id="i-archive" viewBox="0 0 24 24">
    <rect height="4" rx="1" width="18" x="3" y="4"></rect>
    <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"></path>
  </symbol>
  <symbol id="i-warning" viewBox="0 0 24 24">
    <path d="M12 3.5 2.5 20h19z"></path>
    <path d="M12 10v4.5"></path>
    <circle cx="12" cy="17.3" fill="currentColor" r="0.9" stroke="none"></circle>
  </symbol>
  <symbol id="i-error" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 7v6"></path>
    <circle cx="12" cy="16.5" fill="currentColor" r="1" stroke="none"></circle>
  </symbol>
  <symbol id="i-help" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5v.7"></path>
    <circle cx="12" cy="17" fill="currentColor" r="1" stroke="none"></circle>
  </symbol>
  <symbol id="i-cov-all" viewBox="0 0 24 24">
    <rect fill="currentColor" height="5" rx="1" width="5" x="2" y="9.5"></rect>
    <rect fill="currentColor" height="5" rx="1" width="5" x="9.5" y="9.5"></rect>
    <rect fill="currentColor" height="5" rx="1" width="5" x="17" y="9.5"></rect>
  </symbol>
  <symbol id="i-cov-part" viewBox="0 0 24 24">
    <rect fill="currentColor" height="5" rx="1" width="5" x="2" y="9.5"></rect>
    <rect height="5" rx="1" stroke-dasharray="2 1.5" stroke-width="1.5" width="5" x="9.5" y="9.5"></rect>
    <rect height="5" rx="1" stroke-dasharray="2 1.5" stroke-width="1.5" width="5" x="17" y="9.5"></rect>
  </symbol>
  <symbol id="i-cov-none" viewBox="0 0 24 24">
    <rect height="16" rx="2" stroke-dasharray="3 2.5" width="16" x="4" y="4"></rect>
    <path d="m8 16 8-8"></path>
  </symbol>
  <symbol id="i-empty" viewBox="0 0 64 64">
    <rect height="34" rx="4" stroke-dasharray="5 4" width="40" x="6" y="18"></rect>
    <circle cx="42" cy="22" r="11"></circle>
    <path d="m50 30 9 9"></path>
  </symbol>
</svg>

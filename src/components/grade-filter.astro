---
/**
 * The grade controls, including the headline Triple-A toggle.
 *
 * Triple-A is strict: all three axes graded and all three `A` (Glama has no
 * `A-`, so no looser variant exists). Roughly 12% of servers have no grade at
 * all and an ungraded axis is unknown rather than bad, so while a grade filter
 * is active the explorer shows a warning icon with how many servers it cannot
 * speak for.
 *
 * Each axis has a fixed icon (scale = licence, star = quality, wrench =
 * maintenance) before its letter select; ⬚ is "any".
 */
import type { Facets } from "../lib/facets.ts";
import type { GradeCoverage } from "../lib/grade.ts";

import { COVERAGE_LABELS } from "../lib/facet-defs.ts";
import { GRADE_AXES, GRADES } from "../lib/grade.ts";
import { AXIS_ICONS, COVERAGE_ICONS } from "../lib/icons.ts";
import Icon from "./icon.astro";

interface Props {
  facets: Facets;
}

const { facets } = Astro.props;
const coverages = Object.entries(COVERAGE_LABELS) as [GradeCoverage, string][];
---

<fieldset aria-label="Glama grade" class="facet" data-grade>
  <legend><Icon name="grade" /></legend>

  <button aria-label="Triple-A only" aria-pressed="false" class="aaa-toggle" data-action="toggle-aaa" type="button">
    <span class="aaa-mark">AAA</span>
    <span class="tri-count" data-count="aaa">{facets.tripleA}</span>
  </button>

  <div class="grade-axes">
    {
      GRADE_AXES.map((axis) => {
        return (
        <label class="grade-axis">
          <Icon name={AXIS_ICONS[axis]} />
          <span aria-hidden="true">≥</span>
          <select aria-label={`${axis} at least`} data-axis={axis}>
            <option value="">⬚</option>
            {GRADES.map((grade) => <option value={grade}>{grade}</option>)}
          </select>
        </label>
        );
      })
    }
  </div>

  <div class="coverage-row">
    {
      coverages.map(([coverage, label]) => {
        return (
        <button aria-label={label} aria-pressed="false" class="chip" data-coverage={coverage} type="button">
          <Icon name={COVERAGE_ICONS[coverage]} /> <span class="tri-count">{facets.gradeCoverage.get(coverage) ?? 0}</span>
        </button>
        );
      })
    }
  </div>

  <div class="warn" data-ungraded hidden role="status">
    <Icon name="warning" /> <span data-ungraded-text></span>
  </div>
</fieldset>

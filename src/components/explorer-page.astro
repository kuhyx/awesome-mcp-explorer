---
/**
 * The explorer, fully prerendered: header, controls and every server row, so
 * with JavaScript off the whole list, title and description are still there.
 * `<server-explorer>` takes over in the browser (see src/elements).
 */
import type { HomeModel } from "../lib/servers-data.ts";

import { HOME_PAGE } from "../../scripts/lib/site/pages.ts";
import { linkResolver, renderBlocks } from "../../scripts/lib/site/render-html.ts";
import { SITE_NAME } from "../../scripts/lib/site/site-config.ts";
import FilterBar from "./filter-bar.astro";
import PresetMenu from "./preset-menu.astro";
import ServerRow from "./server-row.astro";
import StatBar from "./stat-bar.astro";

interface Props {
  model: HomeModel;
}

const { model } = Astro.props;
const prose = renderBlocks(HOME_PAGE.blocks, linkResolver(HOME_PAGE));
---

<main>
  <server-explorer>
    <div class="app">
      <header class="topbar">
        <h1>{SITE_NAME} <span class="subtitle">{model.total} servers</span></h1>
        <input
          aria-label="Search servers"
          class="search"
          data-search
          placeholder="Fuzzy search name or description…  (/)"
          type="search"
        />
        <PresetMenu />
      </header>

      <StatBar total={model.total} />

      <div class="body">
        <FilterBar model={model} />
        <div class="list" data-list>
          <p class="app-msg" data-error hidden>
            Could not load servers.json: <span data-error-detail></span>. Run <code>pnpm run build:data</code> to generate it.
          </p>
          <p class="list-empty" data-empty hidden>No servers match these filters.</p>
          {model.rows.map((server) => <ServerRow server={server} />)}
        </div>
      </div>
    </div>

    <div class="help" data-help hidden role="dialog">
      <h2>Shortcuts</h2>
      <dl>
        <dt>/</dt>
        <dd>focus search</dd>
        <dt>a</dt>
        <dd>toggle Triple-A</dd>
        <dt>Esc</dt>
        <dd>leave search / close this</dd>
        <dt>?</dt>
        <dd>this help</dd>
      </dl>
      <p>Every filter lives in the URL, so the address bar is always a shareable link.</p>
    </div>
  </server-explorer>

  <section class="prerender" set:html={prose} />
</main>

<script>
  import "../elements/register.ts";
</script>
